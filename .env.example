TYPESAFE_API_KEY=
# Azure Cosmos DB for NoSQL read-only connection string. Restart the backend after changing it.
COSMOS_CONNECTION_STRING=
TYPESAFE_MODEL=jev-latest
PORT=3001
# Relative to the repository root, not the shell's working directory.
DATA_DIR=./data
MAX_UPLOAD_MIB=100
MAX_EXPANDED_MIB=500
MAX_ARCHIVE_FILES=10000
RUN_CONCURRENCY=4
RUN_REQUESTS_PER_SECOND=10
